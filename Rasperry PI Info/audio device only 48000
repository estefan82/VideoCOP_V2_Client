if your mic device only can sample 48000

- procedure

1. arecord -l
    list to find the device position 0, 1 or 2

2. sudo nano /etc/asound.conf

    add content


pcm.mic_resampled {
    type plug
    slave {
        pcm "hw:2,0"
        # Quitamos la línea de 'format' y 'channels' de aquí dentro
        # para que el 'plug' los negocie automáticamente con la tarjeta.
        rate 16000
    }
}

ctl.mic_resampled {
    type hw
    card 2
}

----   o por Device en caso necesario


pcm.mic_resampled {
    type plug
    slave {
        # Usamos el nombre entre corchetes: Device
        pcm "hw:Device"
        rate 44100
    }
}

ctl.mic_resampled {
    type hw
    card "Device"
}

3. sudo reboot

4. test the convertion

    arecord -D mic_resampled -f S16_LE -c 2 -r 16000 -d 5 prueba_v3.wav

5. play & record

    speaker-test -D default -t sine -f 440 -l 1 & arecord -D mic_resampled -f S16_LE -c 1 -r 16000 -d 3 prueba_remota.wav